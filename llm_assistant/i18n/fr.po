#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.llm_prompt_test_view_form
msgid ""
"<strong>Auto-population:</strong> Common fields are automatically added as "
"\"record_fieldname\" when you select a record"
msgstr ""
"<strong>Auto-population : </strong> Les champs communs sont automatiquement "
"ajoutés en tant que \"record_fieldname\" lorsque vous sélectionnez un "
"enregistrement."

#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.view_llm_assistant_form
msgid ""
"<strong>Default Values:</strong> Define default values for prompt variables in JSON format.\n"
"                                    These will be used as inputs to the prompt template."
msgstr ""
"<strong>Default Values : </strong> Définissez les valeurs par défaut pour les variables d'invite au format JSON.\n"
"                                    Ceux-ci seront utilisés comme entrées dans le modèle d’invite."

#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.view_llm_assistant_form
msgid ""
"<strong>Dynamic Defaults:</strong> When enabled, you can use template syntax like\n"
"                                    <code>{{ user.name }}</code> or <code>{{ related_record.get_field('name') }}</code> in your default values."
msgstr ""
"<strong>Dynamic Defaults :</strong> Lorsqu'il est activé, vous pouvez utiliser la syntaxe du modèle comme\n"
"                                    <code>{{ user.name }}</code> ou <code>{{ related_record.get_field('name') }}</code> dans vos valeurs par défaut."

