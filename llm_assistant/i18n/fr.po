"access"
msgstr ""
"<strong>Accès aux enregistrements associés : </strong> Utiliser {{ "
"related_record.get_field('field_name') }} dans les modèles pour un accès "
"direct aux champs"

#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.llm_prompt_test_view_form
